# Supabase (project yvohdlsbjjzsvrxblwoc, shared with the cleaning app)
# Optional: both default to the shared project (see src/lib/supabase/config.ts)
NEXT_PUBLIC_SUPABASE_URL=https://yvohdlsbjjzsvrxblwoc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_x_Ed-u_qI5he95oaxFOM0g_3s90hfx4
# Server only. Supabase dashboard > Project settings > API keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the cron routes and webhooks check (any long random string)
CRON_SECRET=

# Anthropic, for classification, summaries, drafts and commitment extraction
ANTHROPIC_API_KEY=

# Gmail: a Google Cloud OAuth client with the gmail.modify and gmail.send scopes.
# Each PM connects their own inbox from Settings; the refresh token is stored on lane_staff.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dialpad: API key from Dialpad admin > Integrations, plus the webhook secret you set when creating the subscription
DIALPAD_API_KEY=
DIALPAD_WEBHOOK_SECRET=

# Resly (per-account API key)
RESLY_API_KEY=
RESLY_BASE_URL=https://api.resly.com

# Google Sheets: service-account JSON (base64) with read access to both sheets, and the sheet ids
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
MASTER_SHEET_ID=
MAINTENANCE_SHEET_ID=

# NPS tool webhook secret
NPS_WEBHOOK_SECRET=
# Where live mode POSTs survey sends ({ surveyId, ownerId, email, name, kind }, signed x-nps-signature)
NPS_SEND_URL=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Set to "mock" to run every integration from the seed dataset instead of the real APIs
INTEGRATIONS_MODE=mock
